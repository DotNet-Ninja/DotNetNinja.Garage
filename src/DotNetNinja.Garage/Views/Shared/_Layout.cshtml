@{
    var fullBleed = ViewData[ViewKey.FullBleed] is true;
}
<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData[ViewKey.Title] | @AppSettings.ApplicationName</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="garage-shell">
    <header class="site-header">
        <nav class="navbar navbar-expand-md container-fluid px-3 px-lg-5" aria-label="Main navigation">
            <a class="navbar-brand garage-brand" asp-controller="Home" asp-action="Index" aria-label="Garage home">
                <span class="garage-mark" aria-hidden="true"><span></span><span></span><span></span><span></span></span>
                <span class="garage-wordmark">Garage</span>
            </a>
            @await Component.InvokeAsync("Navigation")
        </nav>
    </header>

    <main class="site-main @(fullBleed ? "site-main-bleed" : "")" role="main">
        <div class="@(fullBleed ? "container-fluid p-0" : "container py-5")">
            @RenderBody()
        </div>
    </main>

    <footer class="site-footer">
        <div class="container-fluid px-3 px-lg-5 d-flex flex-wrap align-items-center justify-content-start justify-content-md-between gap-3">
            <a class="garage-brand garage-brand-footer" asp-controller="Home" asp-action="Index" aria-label="Garage home">
                <span class="garage-mark" aria-hidden="true"><span></span><span></span><span></span><span></span></span>
                <span class="garage-wordmark">Garage</span>
            </a>
            <div class="footer-details w-100 w-md-auto ms-md-auto d-flex flex-wrap align-items-center justify-content-between gap-3">
                <span class="footer-copyright"><copyright>@AppSettings.ApplicationName. All rights reserved.</copyright></span>
                <partial name="FooterNavigation" />
            </div>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
