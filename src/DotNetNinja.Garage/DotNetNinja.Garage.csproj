<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>DotNetNinja.Garage.Development</UserSecretsId>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Auth0.AspNetCore.Authentication" Version="1.11.0" />
    <PackageReference Include="DotNetNinja.AutoBoundConfiguration" Version="1.2.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.14" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="ViewComponents\" />
  </ItemGroup>

  <Target Name="SetGarageBuildVersion" BeforeTargets="GetAssemblyVersion" Condition="'$(Version)' == '1.0.0'">
    <MakeDir Directories="$(IntermediateOutputPath)" />
    <Exec Command="pwsh -NoProfile -File &quot;$(MSBuildProjectDirectory)/../../tools/Get-BuildVersion.ps1&quot; -RepositoryRoot &quot;$(MSBuildProjectDirectory)/../..&quot; -OutputFile &quot;$(MSBuildProjectDirectory)/$(IntermediateOutputPath)garage-version.txt&quot;" />
    <ReadLinesFromFile File="$(IntermediateOutputPath)garage-version.txt">
      <Output TaskParameter="Lines" ItemName="GarageBuildVersionOutput" />
    </ReadLinesFromFile>
    <PropertyGroup>
      <Version>@(GarageBuildVersionOutput)</Version>
    </PropertyGroup>
    <Message Importance="High" Text="Garage semantic version: $(Version)" />
  </Target>

</Project>
